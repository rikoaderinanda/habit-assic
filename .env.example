# ──────────────────────────────────────────────────────────────
# Subuh Tracker — environment variables
# Copy to .env (read by both Next.js and the Prisma CLI), then fill in.
# ──────────────────────────────────────────────────────────────

# Supabase → Connect → ORMs → Prisma
# Transaction pooler (port 6543). Used by the app at runtime (serverless-safe).
# connection_limit=5: an instance serves concurrent requests (Vercel Fluid compute);
# with 1, every query of every request is serialised.
# URL-encode special characters in the password (e.g. ? → %3F, @ → %40, # → %23).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Session / direct connection (port 5432). Used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google Cloud Console → Google Auth Platform → Clients → OAuth client (Web application)
# (GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are accepted as aliases.)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local development only. Vercel sets this automatically.
AUTH_URL="http://localhost:3000"

# Comma-separated emails promoted to ADMIN on sign-in.
ADMIN_EMAILS="admin@example.com"

# IANA timezone for "today" and monthly statistics.
APP_TIMEZONE="Asia/Jakarta"
